# TMDB API key — free at https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=your_tmdb_api_key_here

# Leave VITE_API_BASE empty for local dev (Vite proxy handles it)
# VITE_API_BASE=https://your-proxy.railway.app

# RapidAPI — Football Live Streaming API (1xAPI), used by /api/football-live
RAPIDAPI_KEY=
# Minutes to cache 1xAPI responses (free plan = 50 requests/day). Default 30.
FOOTBALL_LIVE_CACHE_MIN=30
# Pages of /matches to load (20 matches each, 1 request per page). Default 1.
FOOTBALL_LIVE_PAGES=1

# Player click ads: Direct Link / Smartlink URL(s), comma-separated (max 2
# used — click 1 opens the first, click 2 the second). Empty = player ads off.
# Shown twice per 30 minutes, separate from the site-wide popunder.
VITE_PLAYER_AD_URLS=
